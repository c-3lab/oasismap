# Copy to terraform.tfvars and set real values. Do not commit terraform.tfvars.
# Backend: run terraform init -backend-config=backend.tfvars with resource_group_name and storage_account_name.

backend_resource_group_name   = "YOUR_TF_STATE_RESOURCE_GROUP_NAME"
backend_storage_account_name  = "YOUR_TF_STATE_STORAGE_ACCOUNT_NAME"

prefix   = "oasismap"
location = "Japan East"

app_service_plan_sku = "P1v2"
app_frontend_name    = "YOUR_UNIQUE_FRONTEND_APP_NAME"
app_backend_name     = "YOUR_UNIQUE_BACKEND_APP_NAME"
app_keycloak_name    = "YOUR_UNIQUE_KEYCLOAK_APP_NAME"

aci_orion_image_tag  = "orion:latest"
aci_cygnus_image_tag = "cygnus:latest"

agw_sku          = "WAF_v2"
agw_min_capacity = 1
agw_max_capacity = 2
agw_waf_mode     = "Prevention"

dns_resource_group_name = "oasismap-dns"
root_domain_name        = "YOUR_DOMAIN_NAME"
